# 로컬 개발용 환경 변수 예시
# 실제 값은 .env 파일에 복사해서 채워 넣고, .env는 절대 커밋하지 말 것.

# Firebase Admin SDK 서비스 계정 키 (로컬 개발 시에만 필요)
# Firebase Console → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성
# 다운로드한 JSON 파일을 Backend/server/ 안에 두고 경로 지정
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# OpenAI API 키 (챗봇 + 레시피 추천)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# OCR (Gemini Vision) API 키 — 영수증/식재료 사진 인식용
# https://aistudio.google.com/app/apikey (무료, Gmail 계정)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# CORS 허용 도메인 (콤마로 구분)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# cron-job.org가 /tasks/check-expiry 호출할 때 헤더에 실어 보낼 비밀키
# (랜덤한 32자 이상 문자열 권장)
CRON_SECRET=replace-me-with-random-32chars

# Swagger UI에서 Bearer dev-token 으로 테스트할 수 있게 함
# (배포 시에는 절대 1로 두지 말 것)
DEV_AUTH_ENABLED=1

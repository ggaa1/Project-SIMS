// Firestore Security Rules — 유통기한/카테고리 보관일수 관련 (expiry-spec-v1.md §6)
//
// ⚠️ 제안(PROPOSAL) 상태 — 아직 firebase.json 에 연결하지 않았고 배포되지 않음.
//
// 배포 전 반드시 확인할 것:
//  1) 현재 Flutter 앱은 Firestore 에 **직접 쓰기**한다(repositories/*.dart →
//     fridges/ingredients/users/chats/recipesHistory/fcmTokens 등 직접 set/update).
//     이 파일에 없는 컬렉션은 기본 deny 가 되어 **앱이 깨진다**. 전체 컬렉션 규칙을
//     먼저 합쳐야 한다.
//  2) categoryShelfLife 의 "API 경유만" 강제(아래 update 규칙)는 프론트가 override
//     수정을 **서버 PATCH(/fridges/{id}/category-shelf-life)** 로 전환한 뒤에만 유효하다.
//     현재처럼 프론트가 fridges 문서를 직접 수정한다면 이 규칙이 그 쓰기를 차단한다.
//  3) appConfig 쓰기는 서버(Admin SDK)만 — Admin SDK 는 규칙을 우회하므로 시드 스크립트는
//     영향받지 않는다.
//
// 즉, 이 파일은 "이렇게 가야 한다"는 목표 규칙의 골격이다. 전체 앱 규칙과 프론트
// 마이그레이션(직접 쓰기 → 서버 API)이 끝난 뒤 firebase.json 의 firestore.rules 로 연결한다.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 전역 기본값: 인증 사용자 읽기, 쓰기는 서버(Admin SDK)만
    match /appConfig/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /fridges/{fridgeId} {
      // 읽기: 멤버만
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.memberUids;

      // 생성: create 시점엔 resource == null 이므로 request.resource 를 본다
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.memberUids;

      // 갱신: 멤버만, 단 categoryShelfLife 는 클라이언트가 직접 못 바꾼다(서버 API 경유 강제)
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.memberUids
                    && request.resource.data.categoryShelfLife
                       == resource.data.categoryShelfLife;

      // ingredients 등 하위 컬렉션 규칙은 전체 앱 규칙 통합 시 함께 정의할 것.
    }
  }
}
